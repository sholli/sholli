//@version=5
indicator("SMC Swing AI Refined (Non-Repaint) [Fixed]", overlay=true, max_labels_count=500, max_lines_count=500)

//========================
// 🔹 Inputs
//========================
swingSens      = input.int(5, "Swing Sensitivity", minval=2, maxval=20, tooltip="Determines the lookback period for identifying swing points. Higher values find more significant swings.")
liqThreshold   = input.float(0.15, "Equal High/Low Threshold %", minval=0.05, maxval=1.0, tooltip="The percentage difference allowed for two highs or lows to be considered 'equal' for liquidity purposes.")
wickPct        = input.int(35, "Min Wick % for Rejection", minval=0, maxval=80, tooltip="The minimum percentage of a candle's range that must be a wick to be considered a rejection.")
useVolume      = input.bool(true, "Use Volume Confirmation", tooltip="If true, signals require volume to be above its 20-period moving average.")

//========================
// 🔹 Helper Functions
//========================
isSwingHigh(len) =>
    high[len] == ta.highest(high, len*2+1)

isSwingLow(len) =>
    low[len] == ta.lowest(low, len*2+1)

bodySize(o, c, h, l) => math.abs(c - o)
wickSize(h, l, o, c) =>
    upWick   = h - math.max(o, c)
    lowWick  = math.min(o, c) - l
    [upWick, lowWick]

wickPctCheck(h, l, o, c, dir) =>
    b = bodySize(o, c, h, l)
    [uw, lw] = wickSize(h, l, o, c)
    totalRange = h - l
    // Avoid division by zero and check wick percentage
    if totalRange == 0
        false
    else
        dir == 1 ? (lw / totalRange) * 100 >= wickPct : (uw / totalRange) * 100 >= wickPct

//========================
// 🔹 Market Structure & CHoCH
//========================
// Variables to store the price and bar index of the last confirmed structural swing points.
var float lastSwingHighPrice = na
var float lastSwingLowPrice = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na

// When a new swing is confirmed by the isSwingHigh/Low function, we update our variables.
if isSwingHigh(swingSens)
    lastSwingHighPrice := high[swingSens]
    lastSwingHighBar := bar_index[swingSens]
if isSwingLow(swingSens)
    lastSwingLowPrice := low[swingSens]
    lastSwingLowBar := bar_index[swingSens]

// A true Change of Character (CHoCH) is a break of the last confirmed structural swing.
chochUp   = not na(lastSwingHighPrice) and ta.crossover(close, lastSwingHighPrice)
chochDown = not na(lastSwingLowPrice) and ta.crossunder(close, lastSwingLowPrice)

//========================
// 🔹 Liquidity Zones (Performance Optimized)
//========================
var line[] liqHighLines = array.new_line()
var line[] liqLowLines  = array.new_line()

// When a new swing high is detected, draw a line.
if isSwingHigh(swingSens)
    l_high = line.new(bar_index - swingSens, high[swingSens], bar_index, high[swingSens], color=color.new(color.red, 30), style=line.style_dotted, extend=extend.right)
    array.push(liqHighLines, l_high)
    // To prevent the script from slowing down, we manage the number of lines.
    // If the array of lines grows too large, we delete the oldest line from the chart and from our array.
    if array.size(liqHighLines) > swingSens
        line.delete(array.shift(liqHighLines))

// When a new swing low is detected, draw a line.
if isSwingLow(swingSens)
    l_low = line.new(bar_index - swingSens, low[swingSens], bar_index, low[swingSens], color=color.new(color.green, 30), style=line.style_dotted, extend=extend.right)
    array.push(liqLowLines, l_low)
    if array.size(liqLowLines) > swingSens
        line.delete(array.shift(liqLowLines))

//========================
// 🔹 Price Action Filters
//========================
bullEngulf = close[1] < open[1] and close > open and close > open[1] and open <= close[1]
bearEngulf = close[1] > open[1] and close < open and close < open[1] and open >= close[1]

// A Fair Value Gap is a three-bar pattern where there is an inefficiency or imbalance.
fvgBull = low > high[2]  // Bullish FVG: Current low is higher than the high of 2 bars ago.
fvgBear = high < low[2]  // Bearish FVG: Current high is lower than the low of 2 bars ago.

// Volume confirmation filter
volOK = not useVolume or (volume > ta.sma(volume, 20))

//========================
// 🔹 Swing Signals (Non-Repainting)
//========================
// A long signal requires a CHoCH up, confirmed by either a bullish engulfing or FVG, a rejection wick, and optional volume.
longCond  = chochUp and (bullEngulf or fvgBull) and wickPctCheck(high, low, open, close, 1) and volOK
// A short signal requires a CHoCH down, confirmed by either a bearish engulfing or FVG, a rejection wick, and optional volume.
shortCond = chochDown and (bearEngulf or fvgBear) and wickPctCheck(high, low, open, close, -1) and volOK

// --- Signal Plotting ---
// We use 'barstate.isconfirmed' to ensure our conditions are met on a closed candle, making the signals non-repainting.
buySignal = longCond and barstate.isconfirmed
sellSignal = shortCond and barstate.isconfirmed

// The plotshape function is called on every bar. The first argument is a boolean series (buySignal or sellSignal)
// that determines when the shape is actually visible on the chart. This is the correct way to plot conditional shapes.
plotshape(buySignal, title="BUY", style=shape.triangleup, color=color.green, location=location.belowbar, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.triangledown, color=color.red, location=location.abovebar, size=size.small)

// Labels can be drawn inside an 'if' block. This is also a valid way to create conditional drawings.
if buySignal
    label.new(bar_index, low, "BUY ⬆", color=color.green, style=label.style_label_up, textcolor=color.white)

if sellSignal
    label.new(bar_index, high, "SELL ⬇", color=color.red, style=label.style_label_down, textcolor=color.white)
