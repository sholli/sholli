//@version=5
// -----------------------------------------------------------------------------
// |                                                                             |
// |                    Enhanced AI Moving Average by Jules                      |
// |                                                                             |
// -----------------------------------------------------------------------------
// |                                                                             |
// | Usage Guide & Recommended Configurations:                                   |
// |                                                                             |
// | This indicator combines a low-lag moving average with a multi-layered       |
// | confirmation system to provide high-probability trading signals. It is      |
// | designed to be non-repainting, with all signals confirmed on bar close.     |
// |                                                                             |
// | How to Use:                                                                 |
// | 1. Trend Identification: The primary MA line changes color to indicate      |
// |    the current trend (Green for Up, Red for Down).                          |
// | 2. Signal Arrows: A Buy (▲) or Sell (▼) arrow appears when a potential      |
// |    entry condition is met, based on a confluence of your selected filters.  |
// | 3. Trade Assistant: A label will appear next to the signal with suggested   |
// |    Entry, Stop Loss (SL), and Take Profit (TP) levels. The reason for the   |
// |    signal (e.g., "Vol+Sweep") is also shown.                                |
// | 4. Filters: Use the inputs to enable/disable confirmations like VWAP,       |
// |    Volume spikes, and Liquidity Sweeps to increase signal confidence.       |
// |                                                                             |
// | Recommended Defaults (Forex Majors - H1, H4):                               |
// | - MA Type: EMA, Length: 21                                                  |
// | - Low-lag Mode: Enabled, Blend Factor: 0.6                                  |
// | - VWAP: Enabled (session)                                                   |
// | - Volume Filter: Enabled, Multiplier: 1.5                                   |
// | - Liquidity Sweeps: Enabled, ATR Multiplier: 1.8                            |
// | - SL/TP: ATR-based SL (1.5x), R:R-based TP (2.0)                            |
// |                                                                             |
// | Recommended Defaults (Crypto - H1, H4):                                     |
// | - MA Type: EMA, Length: 34                                                  |
// | - Volume Filter: Enabled, Multiplier: 1.8 (higher for more volatility)      |
// | - Liquidity Sweeps: Enabled, ATR Multiplier: 2.0                            |
// | - SR Lookback: 75 bars                                                      |
// | - Min Bars Between Signals: 12                                              |
// |                                                                             |
// | Backtesting & Risk Management:                                              |
// | These settings are algorithmic suggestions. Always backtest any strategy    |
// | thoroughly on your chosen asset and timeframe. Manage your risk according   |
// | to your own trading plan.                                                   |
// -----------------------------------------------------------------------------

indicator("Enhanced AI Moving Average", "E-AI MA", overlay=true, max_labels_count=500, max_lines_count=200, max_boxes_count=100)

// ====================================================================================
// ===                                  INPUTS                                    ===
// ====================================================================================

// --- Performance ---
var g_perf = "0. Performance"
lightMode = input.bool(false, title="Enable Light Mode", tooltip="Disables heavier calculations like Support/Resistance detection for faster performance.", group=g_perf)

// --- Base MA ---
var g_ma = "1. Base Moving Average"
maType = input.string("EMA", "MA Type", options=["SMA", "EMA", "WMA", "HMA", "TEMA"], group=g_ma)
maLength = input.int(21, "MA Length", minval=1, group=g_ma)
maSmoothing = input.float(0.6, "Smoothing/Alpha (for custom MAs)", minval=0.0, maxval=1.0, step=0.1, group=g_ma)

// --- Low-lag / Predictive ---
var g_lag = "2. Low-lag / Predictive"
lowLagEnable = input.bool(true, "Enable Low-lag Mode", group=g_lag)
lowLagBlend = input.float(0.6, "Blend Factor (low-lag)", minval=0.0, maxval=1.0, step=0.1, group=g_lag, tooltip="Controls the mix between the regular MA and the faster, low-lag variant. 1.0 is full low-lag, 0.0 is no low-lag.")
predictiveLookback = input.int(5, "Predictive Lookback (non-future)", minval=1, group=g_lag, tooltip="Lookback period for the faster component of the low-lag blend.")

// --- VWAP ---
var g_vwap = "3. VWAP"
useVWAP = input.bool(true, "Enable VWAP (Session)", group=g_vwap)
vwapLookback = input.int(1, "VWAP Lookback (Sessions)", minval=1, group=g_vwap, tooltip="This is a conceptual lookback; VWAP resets each session.")

// --- Liquidity Sweeps ---
var g_liq = "4. Liquidity Sweeps"
useSweep = input.bool(true, "Detect Liquidity Sweeps", group=g_liq)
sweepATRmult = input.float(1.8, "Sweep Wick > ATR *", minval=0.1, step=0.1, group=g_liq, tooltip="A wick is considered a sweep if its length is greater than the current ATR multiplied by this value.")
sweepStrength = input.float(1.5, "Sweep Strength Threshold (Volume)", minval=1.0, step=0.1, group=g_liq, tooltip="The volume on the sweep candle must be this many times the average volume.")

// --- Volume Filters ---
var g_vol = "5. Volume Filters"
useVolumeFilter = input.bool(true, "Require Volume Confirmation", group=g_vol)
volMultiplier = input.float(1.5, "Volume Multiplier Threshold", minval=1.0, step=0.1, group=g_vol, tooltip="Signal requires volume to be this many times greater than its moving average.")

// --- Support & Resistance ---
var g_sr = "6. Support & Resistance"
srMode = input.string("pivot_high_low", "S/R Detection Mode", options=["pivot_high_low", "session_high_low", "zscore_levels"], group=g_sr)
srLookback = input.int(50, "S/R Lookback Bars", minval=5, group=g_sr)

// --- Smart Levels & Pair Adaptation ---
var g_smart = "7. Smart Levels / Pair Adaptation"
pairVolatilityNormalization = input.bool(true, "Enable Pair Volatility Normalization", group=g_smart, tooltip="Adjusts S/R and other level calculations based on the pair's recent volatility.")
normalizationWindow = input.int(100, "Normalization Window (Bars)", minval=20, group=g_smart)

// --- Session Analysis ---
var g_sess = "8. Session Analysis"
sessionFilter = input.bool(false, "Enable Session Filter", group=g_sess, tooltip="Only show signals during the selected session.")
sessionToWatch = input.session("0930-1600", "Session to Highlight", group=g_sess) // Example: NYSE

// --- Trade Assistant ---
var g_trade = "9. Trade Assistant"
showTradeAssistant = input.bool(true, "Show Entry/SL/TP Labels", group=g_trade)
slMode = input.string("ATR", "SL Mode", options=["ATR", "SR-based", "fixed_pips"], group=g_trade)
tpMode = input.string("R:R ratio", "TP Mode", options=["R:R ratio", "SR-target", "Fibonacci"], group=g_trade)
defaultRR = input.float(2.0, "Default R:R", minval=0.1, step=0.1, group=g_trade)
slATRMultiplier = input.float(1.5, "SL ATR Multiplier", minval=0.1, step=0.1, group=g_trade)

// --- Signal Filters ---
var g_sig = "10. Signal Filters"
requireVWAP = input.bool(false, "Require VWAP Confirmation", group=g_sig)
requireVolume = input.bool(true, "Require Volume Confirmation", group=g_sig)
requireSweep = input.bool(false, "Require Liquidity Sweep Confirmation", group=g_sig)
minBarsBetween = input.int(10, "Min Bars Between Signals", minval=0, group=g_sig)

// --- Visuals ---
var g_viz = "11. Visuals"
upArrowColor = input.color(color.new(color.green, 0), "Buy Arrow", inline="arrows", group=g_viz)
dnArrowColor = input.color(color.new(color.red, 0), "Sell Arrow", inline="arrows", group=g_viz)
arrowSize = input.string(size.small, "Arrow Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=g_viz)
maUpColor = input.color(color.new(color.green, 0), "MA Up Color", inline="macolor", group=g_viz)
maDnColor = input.color(color.new(color.red, 0), "MA Down Color", inline="macolor", group=g_viz)
showInfoTable = input.bool(true, "Show Info Table", group=g_viz)


// ====================================================================================
// ===                      (Empty Logic Blocks To Be Filled)                       ===
// ====================================================================================

// ====================================================================================
// ===                      HELPER FUNCTIONS & INDICATORS                         ===
// ====================================================================================

// --- MA Calculation Function ---
f_getMA(src, len, type) =>
    ma = switch type
        "SMA" => ta.sma(src, len)
        "EMA" => ta.ema(src, len)
        "WMA" => ta.wma(src, len)
        "HMA" => ta.hma(src, len)
        "TEMA" => ta.ema(ta.ema(ta.ema(src, len), len), len)
    ma

// --- Core Indicator Calculations ---
// Base MA
baseMA = f_getMA(close, maLength, maType)

// Low-lag MA
fastMA = f_getMA(close, predictiveLookback, maType)
finalMA = lowLagEnable ? (fastMA * lowLagBlend) + (baseMA * (1 - lowLagBlend)) : baseMA

// Auxiliary Indicators
atrValue = ta.atr(14)
avgVolume = ta.sma(volume, 20)
sessionVWAP = ta.vwap // VWAP is session-based by default

// ====================================================================================
// ===                     ADVANCED ANALYSIS ENGINES                              ===
// ====================================================================================

// --- Regime Detection ---
maSlope = finalMA - finalMA[1]
normalizedSlope = maSlope / atrValue
var string regime = "Choppy"
if math.abs(normalizedSlope) > regimeThreshold
    regime := "Trending"
else if math.abs(normalizedSlope) < (regimeThreshold / 2)
    regime := "Ranging"
else
    regime := "Choppy"

// --- Support & Resistance Engine ---
var sr_pivots_high_price = array.new_float(5)
var sr_pivots_low_price = array.new_float(5)

if not lightMode and srMode == "pivot_high_low"
    pHigh = ta.pivothigh(srLookback, srLookback)
    pLow = ta.pivotlow(srLookback, srLookback)
    if not na(pHigh)
        array.unshift(sr_pivots_high_price, pHigh)
        if array.size(sr_pivots_high_price) > 5
            array.pop(sr_pivots_high_price)
    if not na(pLow)
        array.unshift(sr_pivots_low_price, pLow)
        if array.size(sr_pivots_low_price) > 5
            array.pop(sr_pivots_low_price)

// --- Liquidity Sweep Detection ---
f_detectSweep() =>
    isSweep = 0 // -1 for bearish, 1 for bullish
    // Calculate wicks
    upperWick = high - math.max(open, close)
    lowerWick = math.min(open, close) - low

    // Check for bullish sweep (long lower wick taking out lows)
    if lowerWick > sweepATRmult * atrValue and volume > sweepStrength * avgVolume
        // Check if price reversed and closed higher than the low
        if close > low
            isSweep := 1

    // Check for bearish sweep (long upper wick taking out highs)
    if upperWick > sweepATRmult * atrValue and volume > sweepStrength * avgVolume
        // Check if price reversed and closed lower than the high
        if close < high
            isSweep := -1
    isSweep

detectedSweep = f_detectSweep()
// === LIQUIDITY SWEEP DETECTION ===
// To be implemented in Step 3

// ====================================================================================
// ===                  SIGNAL GENERATION & TRADE ASSISTANT                       ===
// ====================================================================================

// --- State and Debounce ---
var lastSignalBar = 0
var lastSignalType = 0 // 1 for buy, -1 for sell

// --- Trade Assistant Data Storage ---
var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var string signalReason = ""

// --- Signal Logic ---
barsSinceLastSignal = bar_index - lastSignalBar

if barsSinceLastSignal > minBarsBetween and barstate.isconfirmed
    // --- Confirmation Checks ---
    volConfirm = not useVolumeFilter or (volume > avgVolume * volMultiplier)
    sweepBuyConfirm = not requireSweep or (detectedSweep == 1)
    sweepSellConfirm = not requireSweep or (detectedSweep == -1)
    vwapBuyConfirm = not requireVWAP or (close > sessionVWAP)
    vwapSellConfirm = not requireVWAP or (close < sessionVWAP)

    // --- Primary Trend Conditions ---
    isTrendUp = close > finalMA and normalizedSlope > regimeThreshold
    isTrendDown = close < finalMA and normalizedSlope < -regimeThreshold

    // --- Final Signal Confluence ---
    buySignal = isTrendUp and volConfirm and sweepBuyConfirm and vwapBuyConfirm
    sellSignal = isTrendDown and volConfirm and sweepSellConfirm and vwapSellConfirm

    // --- Trade Assistant Calculation ---
    if buySignal
        lastSignalBar := bar_index
        lastSignalType := 1
        entryPrice := close

        // SL Calculation
        if slMode == "ATR"
            stopLoss := close - (atrValue * slATRMultiplier)
        else if slMode == "SR-based" and not lightMode and not na(array.last(sr_pivots_low_price))
            stopLoss := array.last(sr_pivots_low_price)
        else // Fallback to ATR
            stopLoss := close - (atrValue * slATRMultiplier)

        // TP Calculation
        if tpMode == "R:R ratio"
            takeProfit := close + (close - stopLoss) * defaultRR
        else if tpMode == "SR-target" and not lightMode and not na(array.last(sr_pivots_high_price))
            takeProfit := array.last(sr_pivots_high_price)
        else // Fallback to R:R
            takeProfit := close + (close - stopLoss) * defaultRR

        // Reason
        signalReason := "Trend" + (volConfirm ? "+Vol" : "") + (sweepBuyConfirm and requireSweep ? "+Sweep" : "") + (vwapBuyConfirm and requireVWAP ? "+VWAP" : "")

    if sellSignal
        lastSignalBar := bar_index
        lastSignalType := -1
        entryPrice := close

        // SL Calculation
        if slMode == "ATR"
            stopLoss := close + (atrValue * slATRMultiplier)
        else if slMode == "SR-based" and not lightMode and not na(array.last(sr_pivots_high_price))
            stopLoss := array.last(sr_pivots_high_price)
        else // Fallback to ATR
            stopLoss := close + (atrValue * slATRMultiplier)

        // TP Calculation
        if tpMode == "R:R ratio"
            takeProfit := close - (stopLoss - close) * defaultRR
        else if tpMode == "SR-target" and not lightMode and not na(array.last(sr_pivots_low_price))
            takeProfit := array.last(sr_pivots_low_price)
        else // Fallback to R:R
            takeProfit := close - (stopLoss - close) * defaultRR

        // Reason
        signalReason := "Trend" + (volConfirm ? "+Vol" : "") + (sweepSellConfirm and requireSweep ? "+Sweep" : "") + (vwapSellConfirm and requireVWAP ? "+VWAP" : "")

// === TRADE ASSISTANT CALCULATIONS ===
// To be implemented in Step 4

// ====================================================================================
// ===                         PLOTS and LABELS                                   ===
// ====================================================================================

// --- Plot MA and VWAP ---
plot(finalMA, "Moving Average", color=maSlope > 0 ? maUpColor : maDnColor, linewidth=2)
plot(useVWAP ? sessionVWAP : na, "VWAP", color=color.new(color.blue, 0), style=plot.style_linebr)

// --- Plot S/R Lines ---
var sr_lines = array.new_line()
if not lightMode and barstate.islast
    // Clear old lines
    for lineId in sr_lines
        line.delete(lineId)
    array.clear(sr_lines)

    // Draw new lines
    for price in sr_pivots_high_price
        if not na(price)
            array.push(sr_lines, line.new(bar_index[srLookback], price, bar_index, price, color=color.new(color.red, 50), style=line.style_dashed))
    for price in sr_pivots_low_price
        if not na(price)
            array.push(sr_lines, line.new(bar_index[srLookback], price, bar_index, price, color=color.new(color.green, 50), style=line.style_dashed))

// --- Plot Arrows and Trade Assistant Labels ---
var label tradeLabel = na
var buySignalBar = 0
var sellSignalBar = 0

// Need to capture the signal from the logic block to use here for plotting
buySignalTrigger = lastSignalType == 1 and lastSignalBar == bar_index
sellSignalTrigger = lastSignalType == -1 and lastSignalBar == bar_index

if buySignalTrigger
    buySignalBar := bar_index
    plotshape(true, "Buy Signal", style=shape.arrowup, location=location.belowbar, color=upArrowColor, size=arrowSize, offset=-1)
    if showTradeAssistant
        label.delete(tradeLabel)
        rr_value = (takeProfit - entryPrice) / (entryPrice - stopLoss)
        labelText = "Entry: " + str.tostring(entryPrice, "#.#####") +
                   "\nSL: " + str.tostring(stopLoss, "#.#####") +
                   "\nTP: " + str.tostring(takeProfit, "#.#####") +
                   "\nR:R: 1:" + str.tostring(rr_value, "#.##") +
                   "\nReason: " + signalReason
        tradeLabel := label.new(bar_index, low, text=labelText, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, yloc=yloc.belowbar)

if sellSignalTrigger
    sellSignalBar := bar_index
    plotshape(true, "Sell Signal", style=shape.arrowdown, location=location.abovebar, color=dnArrowColor, size=arrowSize, offset=-1)
    if showTradeAssistant
        label.delete(tradeLabel)
        rr_value = (entryPrice - takeProfit) / (stopLoss - entryPrice)
        labelText = "Entry: " + str.tostring(entryPrice, "#.#####") +
                   "\nSL: " + str.tostring(stopLoss, "#.#####") +
                   "\nTP: " + str.tostring(takeProfit, "#.#####") +
                   "\nR:R: 1:" + str.tostring(rr_value, "#.##") +
                   "\nReason: " + signalReason
        tradeLabel := label.new(bar_index, high, text=labelText, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, yloc=yloc.abovebar)

// --- Info Table ---
var table infoTable = table.new(position.top_right, 2, 4)
if showInfoTable and barstate.islast
    table.cell(infoTable, 0, 0, "Market Regime", bgcolor=color.new(color.gray, 50))
    table.cell(infoTable, 1, 0, regime, bgcolor=regime == "Trending" ? maUpColor : regime == "Ranging" ? color.orange : color.gray)
    table.cell(infoTable, 0, 1, "MA Slope (Norm.)", bgcolor=color.new(color.gray, 50))
    table.cell(infoTable, 1, 1, str.tostring(normalizedSlope, "#.####"), bgcolor=color.new(color.gray, 80))
    table.cell(infoTable, 0, 2, "ATR", bgcolor=color.new(color.gray, 50))
    table.cell(infoTable, 1, 2, str.tostring(atrValue, "#.#####"), bgcolor=color.new(color.gray, 80))
    table.cell(infoTable, 0, 3, "Last Signal", bgcolor=color.new(color.gray, 50))
    table.cell(infoTable, 1, 3, lastSignalType == 1 ? "BUY" : lastSignalType == -1 ? "SELL" : "None", bgcolor=lastSignalType == 1 ? upArrowColor : lastSignalType == -1 ? dnArrowColor : color.gray)

// ====================================================================================
// ===                                 ALERTS                                     ===
// ====================================================================================
alertcondition(buySignalTrigger, title="Enhanced MA Buy", message="E-AI MA Buy Signal for {{ticker}}")
alertcondition(sellSignalTrigger, title="Enhanced MA Sell", message="E-AI MA Sell Signal for {{ticker}}")
alertcondition(detectedSweep == 1, title="Bullish Liquidity Sweep", message="Bullish liquidity sweep detected on {{ticker}}")
alertcondition(detectedSweep == -1, title="Bearish Liquidity Sweep", message="Bearish liquidity sweep detected on {{ticker}}")
