//@version=5
indicator("Smart Money AI [Jules]", "SMAI", overlay=true)

// © 2024 Jules
// This indicator is a comprehensive tool designed to identify high-probability swing trading opportunities
// by emulating smart money concepts. It combines three core analytical components:
// 1. Market Structure Engine: Automatically identifies swing points (pivots) and classifies them as
//    Higher Highs (HH), Higher Lows (HL), Lower Highs (LH), and Lower Lows (LL). It also detects
//    Breaks of Structure (BOS) and Changes of Character (CHOCH) to determine the trend.
// 2. Liquidity Analysis: Highlights potential liquidity zones by detecting equal highs and lows,
//    which are often targets for liquidity grabs.
// 3. Price Action Confirmation: Recognizes key candlestick patterns such as engulfing candles,
//    Fair Value Gaps (FVGs), and Order Blocks to confirm entries after a structural shift.
//
// The final output is a set of non-repainting BUY and SELL arrows that appear after a confirmed
// liquidity sweep, a structural change, and a price action-based confirmation.

//----------------------------------------------------------------------------------------------------
// Section 0: User Inputs
//----------------------------------------------------------------------------------------------------
// Market Structure Inputs
pivotLookback_L = input.int(15, title="Pivot Lookback Left", group="Market Structure")
pivotLookback_R = input.int(15, title="Pivot Lookback Right", group="Market Structure")
eq_threshold = input.float(0.05, "Equal H/L Threshold %", group="Market Structure") / 100

// Visuals
showPivots = input.bool(true, title="Show Pivots", group="Visuals")
showHHLL = input.bool(true, title="Show HH/LL Labels", group="Visuals")
showBOS = input.bool(true, title="Show BOS/CHOCH", group="Visuals")
showLiquidity = input.bool(true, title="Show Liquidity Zones", group="Visuals")
showSignals = input.bool(true, title="Show Buy/Sell Signals", group="Visuals")

// Style
buyColor = input.color(color.new(#2962FF, 0), "Buy Arrow Color", group="Style")
sellColor = input.color(color.new(#E91E63, 0), "Sell Arrow Color", group="Style")
textColor = input.color(color.white, "Text Color", group="Style")
bosColor = input.color(color.new(color.gray, 50), "BOS/CHOCH Line Color", group="Style")

//----------------------------------------------------------------------------------------------------
// Section 1: Market Structure Engine
//----------------------------------------------------------------------------------------------------

// Type to store pivot point information
type Pivot
    float price
    int bar
    string type // "H" or "L"

// Find pivot points
pHigh = ta.pivothigh(high, pivotLookback_L, pivotLookback_R)
pLow = ta.pivotlow(low, pivotLookback_L, pivotLookback_R)

// Plot pivots for debugging/visuals
plotshape(pHigh and showPivots, style=shape.circle, location=location.abovebar, color=color.new(color.red, 20), size=size.tiny, title="Pivot High")
plotshape(pLow and showPivots, style=shape.circle, location=location.belowbar, color=color.new(color.blue, 20), size=size.tiny, title="Pivot Low")

// Arrays to store the history of pivots
var pivot_points = array.new<Pivot>()

// Function to add a new pivot to the array
add_pivot(price, bar, type) =>
    array.push(pivot_points, Pivot.new(price, bar, type))

// Detect and store new pivots
if not na(pHigh)
    add_pivot(pHigh, bar_index - pivotLookback_R, "H")

if not na(pLow)
    add_pivot(pLow, bar_index - pivotLookback_R, "L")

// Type to store classified swing point information
type Swing
    float price
    int bar
    string type // "HH", "LH", "HL", "LL"

var swings = array.new<Swing>()
var trend = "N" // "U" for Uptrend, "D" for Downtrend, "N" for Neutral

// Function to get the last major high or low swing
get_last_major_swing(swing_array, type) => // type = "H" or "L"
    Swing result = na
    if array.size(swing_array) > 0
        for i = array.size(swing_array) - 1 to 0
            s = array.get(swing_array, i)
            if (type == "H" and (s.type == "HH" or s.type == "LH")) or (type == "L" and (s.type == "HL" or s.type == "LL"))
                result := s
                break
    result

// Process pivots to classify swings and detect structure (for historical visualization)
process_swings() =>
    if array.size(pivot_points) < 2
        na

    temp_swings = array.new<Swing>()
    temp_trend = "N"

    first_pivot = array.get(pivot_points, 0)
    array.push(temp_swings, Swing.new(first_pivot.price, first_pivot.bar, first_pivot.type == "H" ? "LH" : "LL"))

    for i = 1 to array.size(pivot_points) - 1
        current_pivot = array.get(pivot_points, i)
        last_swing = array.last(temp_swings)

        if current_pivot.type == last_swing.type
            continue

        last_high = get_last_major_swing(temp_swings, "H")
        last_low = get_last_major_swing(temp_swings, "L")

        swing_type = ""
        bos_choch_price = 0.0
        bos_choch_type = ""
        bos_choch_anchor_bar = 0

        if current_pivot.type == "H"
            if na(last_high) or current_pivot.price > last_high.price
                swing_type := "HH"
                if temp_trend == "D"
                    bos_choch_type := "CHOCH"
                    bos_choch_price := last_high.price
                    bos_choch_anchor_bar := last_high.bar
                else if temp_trend == "U"
                    bos_choch_type := "BOS"
                    bos_choch_price := last_high.price
                    bos_choch_anchor_bar := last_high.bar
                temp_trend := "U"
            else
                swing_type := "LH"
        else // current_pivot.type == "L"
            if na(last_low) or current_pivot.price < last_low.price
                swing_type := "LL"
                if temp_trend == "U"
                    bos_choch_type := "CHOCH"
                    bos_choch_price := last_low.price
                    bos_choch_anchor_bar := last_low.bar
                else if temp_trend == "D"
                    bos_choch_type := "BOS"
                    bos_choch_price := last_low.price
                    bos_choch_anchor_bar := last_low.bar
                temp_trend := "D"
            else
                swing_type := "HL"

        array.push(temp_swings, Swing.new(current_pivot.price, current_pivot.bar, swing_type))

        if bos_choch_price > 0 and showBOS
            line.new(bos_choch_anchor_bar, bos_choch_price, current_pivot.bar, bos_choch_price, color=bosColor, style=line.style_dashed)
            label.new(current_pivot.bar, bos_choch_price, bos_choch_type, style=label.style_none, textcolor=textColor)

    temp_swings

// Drawing Logic for historical structure
draw_labels(swing_array) =>
    if showHHLL and array.size(swing_array) > 0
        for i = 0 to array.size(swing_array) - 1
            s = array.get(swing_array, i)
            style = s.type == "HH" or s.type == "LH" ? label.style_label_down : label.style_label_up
            y_loc = s.type == "HH" or s.type == "LH" ? yloc.abovebar : yloc.belowbar
            color = s.type == "HH" or s.type == "HL" ? color.new(color.green, 20) : color.new(color.red, 20)
            label.new(s.bar, s.price, s.type, yloc=y_loc, color=color, textcolor=textColor, style=style)

//----------------------------------------------------------------------------------------------------
// Section 2: Liquidity and Price Action Analysis
//----------------------------------------------------------------------------------------------------

// Liquidity Detection (for visualization only, runs on last bar for performance)
detect_liquidity(pivots) =>
    if showLiquidity and array.size(pivots) > 1
        for i = 0 to array.size(pivots) - 2
            p1 = array.get(pivots, i)
            for j = i + 1 to array.size(pivots) - 1
                p2 = array.get(pivots, j)
                if p1.type == p2.type and math.abs(p1.price - p2.price) / p1.price < eq_threshold
                    l_color = p1.type == "H" ? color.new(color.red, 40) : color.new(color.green, 40)
                    l = line.new(p1.bar, p1.price, p2.bar, p2.price, color=l_color, width=1, style=line.style_dotted)
                    line.set_extend(l, extend.right)

// Price Action Patterns
is_bullish_engulfing() => open[1] > close[1] and close > open and close > open[1] and open < close[1]
is_bearish_engulfing() => open[1] < close[1] and close < open and close < open[1] and open > close[1]
is_fvg_up() => low > high[2]
is_fvg_down() => high < low[2]
is_bullish_ob() => close[1] < open[1] and high > high[1] // Last down candle engulfed by a strong up move
is_bearish_ob() => close[1] > open[1] and low < low[1]  // Last up candle engulfed by a strong down move

//----------------------------------------------------------------------------------------------------
// Section 3: Signal Generation and Arrow Logic (Real-time, Non-repainting)
//----------------------------------------------------------------------------------------------------

var rt_swings = array.new<Pivot>()

// Process pivots in real-time for signal generation
if not na(pHigh)
    array.push(rt_swings, Pivot.new(pHigh, bar_index - pivotLookback_R, "H"))
if not na(pLow)
    array.push(rt_swings, Pivot.new(pLow, bar_index - pivotLookback_R, "L"))

// Keep the real-time array size manageable
if array.size(rt_swings) > 10
    array.shift(rt_swings)

var last_buy_signal_bar = 0
var last_sell_signal_bar = 0

// Non-repainting signal generation function
check_signals() =>
    buySignal = false
    sellSignal = false

    // A valid signal pattern requires at least 4 alternating pivots
    if array.size(rt_swings) >= 4
        // --- Buy Signal Logic ---
        // Looks for a pattern: Low -> High -> Lower Low (liquidity sweep) -> Higher High (CHOCH)
        p0 = array.get(rt_swings, array.size(rt_swings) - 4) // Initial Low
        p1 = array.get(rt_swings, array.size(rt_swings) - 3) // High
        p2 = array.get(rt_swings, array.size(rt_swings) - 2) // Lower Low (the sweep)
        p3 = array.get(rt_swings, array.size(rt_swings) - 1) // Higher High (the CHOCH)

        if p0.type == "L" and p1.type == "H" and p2.type == "L" and p3.type == "H"
            is_liquidity_sweep_low = p2.price < p0.price
            is_choch_up = p3.price > p1.price

            if is_liquidity_sweep_low and is_choch_up and bar_index > last_buy_signal_bar
                if is_bullish_engulfing() or is_fvg_up() or is_bullish_ob()
                    buySignal := true
                    last_buy_signal_bar := bar_index

        // --- Sell Signal Logic ---
        // Looks for a pattern: High -> Low -> Higher High (liquidity sweep) -> Lower Low (CHOCH)
        p0_sell = array.get(rt_swings, array.size(rt_swings) - 4) // Initial High
        p1_sell = array.get(rt_swings, array.size(rt_swings) - 3) // Low
        p2_sell = array.get(rt_swings, array.size(rt_swings) - 2) // Higher High (the sweep)
        p3_sell = array.get(rt_swings, array.size(rt_swings) - 1) // Lower Low (the CHOCH)

        if p0_sell.type == "H" and p1_sell.type == "L" and p2_sell.type == "H" and p3_sell.type == "L"
            is_liquidity_sweep_high = p2_sell.price > p0_sell.price
            is_choch_down = p3_sell.price < p1_sell.price

            if is_liquidity_sweep_high and is_choch_down and bar_index > last_sell_signal_bar
                if is_bearish_engulfing() or is_fvg_down() or is_bearish_ob()
                    sellSignal := true
                    last_sell_signal_bar := bar_index

    [buySignal, sellSignal]

// Execute signal check on bar confirmation
if barstate.isconfirmed
    [buy, sell] = check_signals()
    if showSignals
        if buy
            label.new(bar_index, low, "BUY", style=label.style_arrowup, yloc=yloc.belowbar, color=buyColor, textcolor=textColor, size=size.normal)
        if sell
            label.new(bar_index, high, "SELL", style=label.style_arrowdown, yloc=yloc.abovebar, color=sellColor, textcolor=textColor, size=size.normal)

//----------------------------------------------------------------------------------------------------
// Section 4: Execute visualization on the last bar to avoid overloading the chart
//----------------------------------------------------------------------------------------------------
if barstate.islast
    // Process and draw historical market structure
    historic_swings = process_swings()
    draw_labels(historic_swings)

    // Detect and draw historical liquidity zones
    detect_liquidity(pivot_points)
